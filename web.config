<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS HttpPlatformHandler config for the Internet Assist Flask API.
  Requires: IIS HttpPlatformHandler module installed on the server.
  Download: https://www.iis.net/downloads/microsoft/httpplatformhandler
-->
<configuration>
  <system.webServer>

    <handlers>
      <add name="PythonHandler" path="*" verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <!--
      processPath: path to python.exe inside the venv
      IIS spawns this process and proxies all HTTP to it via %HTTP_PLATFORM_PORT%
    -->
    <httpPlatform
        processPath=".\venv\Scripts\python.exe"
        arguments="waitress_server.py"
        stdoutLogEnabled="true"
        stdoutLogFile=".\logs\python_stdout.log"
        startupTimeLimit="120"
        requestTimeout="00:04:00"
        startupRetryCount="3"
        processesPerApplication="2">
      <!--
        processesPerApplication: IIS starts this many Waitress processes and
        load-balances requests across them -- one crashing or restarting
        doesn't take the API down, and Python gets a second CPU core. Each
        uses ~100-200 MB; raise only if Admin -> Monitoring shows the server
        has the memory. Rate limits are kept per process unless REDIS_URL is
        set; the chatbot's AI budget is shared through the database.
      -->
      <environmentVariables>
        <environmentVariable name="APP_ENV"           value="production" />
        <environmentVariable name="HTTP_PLATFORM_PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="WAITRESS_THREADS"  value="8" />
      </environmentVariables>
    </httpPlatform>

    <!--
      IIS rejects bodies over ~28.6 MB by default, before Flask sees them.
      256 MB allows the admin MSI upload (250 MB); every other route is
      capped at 10 MB by the app itself (MAX_CONTENT_LENGTH).
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="268435456" />
      </requestFiltering>
    </security>

    <!-- Strip server identity headers -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Server" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>
</configuration>
