# ── Chatbot (all optional, defaults shown) ──
# Public site the chatbot learns from (its sitemap.xml + prerendered pages).
SITE_URL=https://www.ia.uk
CHAT_KNOWLEDGE_MAX_AGE_HOURS=24
CHAT_MAX_AI_CALLS_PER_SESSION=15
CHAT_MAX_AI_CALLS_PER_DAY=500

# ── Performance / monitoring (all optional, defaults shown) ──
WAITRESS_THREADS=8
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
BACKGROUND_WORKERS=2
MONITORING_ENABLED=true
SLOW_REQUEST_MS=2000
MEMORY_WARN_MB=700
RETENTION_PAGE_VIEWS_DAYS=395
RETENTION_CHAT_DAYS=90
RETENTION_AUDIT_DAYS=730
RETENTION_METRICS_DAYS=30
# Shared rate-limit storage across worker processes (optional).
